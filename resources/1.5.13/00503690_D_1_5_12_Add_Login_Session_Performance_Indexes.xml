    </Step>
    <Step DBType="Postgres" Parse="Y" SeqNo="70" StepType="SQL">
      <SQLStatement>CREATE INDEX IF NOT EXISTS idx_ad_form_access_ad_role_id ON AD_Form_Access (AD_Role_ID);</SQLStatement>
